{
    "name": "webkul/marketplace",
    "description": "Bagisto custom marketplace package",
    "license": "MIT",
    "authors": [
        {
            "name": "Webkul Software",
            "email": "support@bagisto.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^9|^10|^11|^12",
        "webkul/core": "*"
    },
    "autoload": {
